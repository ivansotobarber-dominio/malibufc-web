# El frontend funciona en modo simulado mientras no exista un despliegue seguro.
CONTROL_API_MODE=mock
CONTROL_API_BASE_URL=

# YouTube Malibú FC, sólo en el entorno local, nunca en GitHub Pages.
# El JSON OAuth y los tokens deben vivir fuera del repositorio.
YOUTUBE_OAUTH_CLIENT_JSON=private-data/youtube/client_secret.json
YOUTUBE_TOKEN_PATH=private-data/youtube/token.json
YOUTUBE_CHANNEL_METADATA_PATH=private-data/youtube/channel.json
# Se rellena después de confirmar el canal desde OAuth.
MALIBU_FC_CHANNEL_ID=
